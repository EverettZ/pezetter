{
    "extends": "../tslint.json",
    "rules": {
        "directive-selector": [
            true,
            "attribute",
            "pez",
            "camelCase"
        ],
        "component-selector": [
            true,
            "element",
            "pez",
            "kebab-case"
        ],
        "no-trailing-whitespace": false,
        "newline-before-return": false,
        "max-line-length": false,
        "eofline": false
    }
}